rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // B22: sabit platform admin'leri (useAppUser/AdminPanel'deki ADMIN_EMAILS ile birebir aynı olmalı)
    function isPlatformAdminEmail() {
      return request.auth != null &&
             request.auth.token.email in ['ismail.kaleci@gmail.com', 'tonguc.urunler@gmail.com', 'yasindemir111@gmail.com'];
    }

    function isAdmin() {
      return request.auth != null && (
        isPlatformAdminEmail() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function signedIn() {
      return request.auth != null;
    }

    // B21: demo sınıfı kontrolü
    function isDemoClass(classId) {
      return classId == 'demo-class-yz501' || classId.matches('^demo-.*');
    }

    // B21: sınıf eğitmeni kontrolü
    function isInstructor(classId) {
      return signedIn() &&
             (isDemoClass(classId) || get(/databases/$(database)/documents/classes/$(classId)).data.instructorId == request.auth.uid);
    }

    // B21: sınıfa kayıtlı öğrenci kontrolü
    function isEnrolled(classId) {
      return signedIn() &&
             exists(/databases/$(database)/documents/classes/$(classId)/enrollments/$(request.auth.uid));
    }

    // Kullanıcılar Koleksiyonu
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // B22: kendi belgesini oluşturan kullanıcı için role/plan/featureGrants YASAK (yetki kaçışı kapısı)
      allow create: if request.auth != null && request.auth.uid == userId &&
        (isPlatformAdminEmail() || (
          request.resource.data.get('role', 'user') in ['user', 'student'] &&
          request.resource.data.get('plan', 'free') == 'free' &&
          !('featureGrants' in request.resource.data)
        ));
      // B22: kendi güncellemesi dailyUsage/onboarding vb. ile sınırlı; role/plan/featureGrants yalnız
      // admin veya sabit platform admin e-postası üzerinden değişebilir (özel-atama senkronu dahil)
      allow update: if isAdmin() || (request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['featureGrants']) &&
        (isPlatformAdminEmail() || request.resource.data.get('role', 'user') in ['user', 'student'] || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'plan'])));
      allow delete: if isAdmin();
    }

    // Projeler Koleksiyonu (GİZLİLİK GÜNCELLEMESİ)
    match /projects/{projectId} {
      // Sahibi okuyabilir veya Admin metrikler için görebilir
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Adminler projeleri güncelleyebilir (Eğitildi olarak işaretlemek için)
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Anonim Feedback Koleksiyonu (ADMİN PANELİ İÇİN)
    match /feedback_summaries/{feedbackId} {
      allow read: if isAdmin(); // Adminler buradan analiz sonuçlarını görür
      allow create: if request.auth != null; // Her kullanıcı geri bildirim bırakabilir
    }

    // Diğer kurallar aynen korunur...
    match /customTones/{toneId} {
      allow read, update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    // Landing Page & Footer CMS Ayarları (Kamuya açık tanıtım içeriği; herkes okuyabilir, adminler yazar)
    match /settings/landingPage {
      allow read: if true;
      allow write: if isAdmin() || isPlatformAdminEmail();
    }
    match /settings/{settingId} {
      allow read: if true;
      // Sentinel durum güncellemeleri tüm authenticated kullanıcılara açık
      allow update: if request.auth != null && settingId == 'system' && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['sentinelStatus', 'sentinelLastMessage', 'sentinelLastCheck']
        );
      allow write: if isAdmin();
    }
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    // Sentinel Logları (Admin panelinden okunur)
    match /sentinelLogs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    // API Anahtar Yönetimi (maskelenmiş metadata — tam anahtarlar SAKLANMAZ)
    match /apiKeys/{keyId} {
      allow read: if request.auth != null;       // Herkes sağlık durumunu görebilir
      allow create, update: if request.auth != null; // Anahtar kaydı/güncelleme
      allow delete: if isAdmin();                // Sadece admin silebilir
    }

    // Blog Yazıları (Herkes okuyabilir, sadece yöneticiler yönetir)
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin() || isPlatformAdminEmail();
    }

    // ===== B21 — SINIF/ÖDEV/TESLİM AĞACI (Turnitin kurumsal modeli) =====

    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isDemoClass(classId) || request.resource.data.instructorId == request.auth.uid);
      allow update: if signedIn() && (isDemoClass(classId) || isAdmin() || (
        (resource.data.instructorId == request.auth.uid &&
         request.resource.data.instructorId == resource.data.instructorId &&
         request.resource.data.classCode == resource.data.classCode) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentCount'])
      ));
      allow delete: if signedIn() && (isDemoClass(classId) || isAdmin());

      match /enrollments/{studentId} {
        allow read: if signedIn() && (isDemoClass(classId) || isAdmin() || request.auth.uid == studentId || isInstructor(classId) || resource.data.studentEmail == request.auth.token.email);
        allow create: if signedIn() && (
          isDemoClass(classId) ||
          (request.auth.uid == studentId &&
           request.resource.data.studentId == request.auth.uid &&
           get(/databases/$(database)/documents/classes/$(classId)).data.archived == false) ||
          (isInstructor(classId) &&
           request.resource.data.pending == true &&
           request.resource.data.addedBy == request.auth.uid &&
           request.resource.data.studentId == studentId &&
           get(/databases/$(database)/documents/classes/$(classId)).data.archived == false)
        );
        allow delete: if signedIn() && (isDemoClass(classId) || isAdmin() || request.auth.uid == studentId || isInstructor(classId) || resource.data.studentEmail == request.auth.token.email);
        allow update: if signedIn() && isDemoClass(classId);
      }

      match /assignments/{assignmentId} {
        allow read: if signedIn() && (isDemoClass(classId) || isAdmin() || isInstructor(classId) || isEnrolled(classId));
        allow create, update, delete: if signedIn() && (isDemoClass(classId) || isAdmin() || isInstructor(classId));
      }

      match /assignments/{assignmentId}/submissions/{submissionId} {
        allow read: if signedIn() && (isDemoClass(classId) || isAdmin() || isInstructor(classId) || request.auth.uid == submissionId);
        allow create, update: if signedIn() && (isDemoClass(classId) || isAdmin() || isInstructor(classId) ||
          (request.auth.uid == submissionId && isEnrolled(classId) &&
           request.resource.data.studentId == submissionId));
      }

      // Faz 3: intihal deposu – okuma eğitmen/admin, yazma yalnız sunucu
      match /repository/{docId} {
        allow read: if isAdmin() || isInstructor(classId);
        allow write: if false;
      }
    }

    // Öğrencinin kayıtlı olduğu sınıfların aynası (listeleme için)
    match /users/{userId}/classEnrollments/{mirrorClassId} {
      allow read, delete: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if false;
    }

    // Faz 2: Platform İçi Sentetik Üretim Parmak İzi Havuzu (Zero-Knowledge 4-gram Shingle Parmak İzleri)
    match /internalGeneratedVault/{vaultId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
