; Script generated by Sentience AI Architecture Team
#define MyAppName "Sentience AI Word Add-in"
#define MyAppVersion "2.5.0"
#define MyAppPublisher "Sentience AI"
#define MyAppURL "https://sentience-ai-free-2026.web.app"
#define MyAppExeName "SentienceWordSetup.exe"

[Setup]
AppId={{B720B571-081B-4E38-A7F7-9D6031A56CE2}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={localappdata}\SentienceAI\WordAddin
DisableDirPage=yes
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
OutputBaseFilename=SentienceWordInstaller
Compression=lzma
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest

[Languages]
Name: "turkish"; MessagesFile: "compiler:Languages\Turkish.isl"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "..\public\word-addin\manifest.xml"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\public\word-addin\manifest.xml"; DestDir: "{localappdata}\Microsoft\Office\16.0\Wef"; DestName: "sentience-ai-manifest.xml"; Flags: ignoreversion

[Registry]
Root: HKCU; Subkey: "Software\Microsoft\Office\16.0\WEF\TrustedCatalogs\{{B720B571-081B-4E38-A7F7-9D6031A56CE2}"; ValueType: string; ValueName: "Id"; ValueData: "{{B720B571-081B-4E38-A7F7-9D6031A56CE2}"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Microsoft\Office\16.0\WEF\TrustedCatalogs\{{B720B571-081B-4E38-A7F7-9D6031A56CE2}"; ValueType: string; ValueName: "Url"; ValueData: "{app}"; Flags: uninsdeletekey
Root: HKCU; Subkey: "Software\Microsoft\Office\16.0\WEF\TrustedCatalogs\{{B720B571-081B-4E38-A7F7-9D6031A56CE2}"; ValueType: dword; ValueName: "Flags"; ValueData: "1"; Flags: uninsdeletekey
